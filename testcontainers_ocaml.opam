# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Docker containers for OCaml integration tests"
description: """
TestContainers is an OCaml library that provides lightweight, throwaway
      instances of databases, message brokers, or any service that runs in a
      Docker container. Built on Eio for OCaml 5+, it enables reliable
      integration testing with real services instead of mocks."""
maintainer: ["Sachin Beniwal <sachinbeniwal0101.com>"]
authors: ["Sachin Beniwal <sachinbeniwal0101.com>"]
license: "Apache-2.0"
tags: ["docker" "testing" "integration-testing" "containers"]
homepage: "https://github.com/benodiwal/testcontainers_ocaml"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/benodiwal/testcontainers_ocaml/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/benodiwal/testcontainers_ocaml.git"
x-maintenance-intent: ["(latest)"]
